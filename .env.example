# ------------------------------------------------------------------
# EstateDB configuration. Copy this file to ".env" and edit the values.
# ------------------------------------------------------------------

# --- Database Connection (PostgreSQL) -----------------------------
# On Render or cloud hosts, DATABASE_URL is automatically provided:
# DATABASE_URL=postgresql://user:password@host:5432/estatedb

# Local PostgreSQL defaults:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=estatedb

# Set to true when connecting to remote cloud PostgreSQL (Render, Neon, Supabase, etc.)
DB_SSL=false

# --- Web app ------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string-for-your-project
APP_HOST=0.0.0.0
APP_PORT=8000
